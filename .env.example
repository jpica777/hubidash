# =============================================================================
# HubiDash configuration
# Copy to .env and fill in. Never commit .env.
# =============================================================================

# How the server reaches the hub: "cloud" (via cloud.hubitat.com, works from
# anywhere, e.g. Railway) or "local" (direct LAN access, e.g. on a home NAS).
# Cloud mode polls every 8s, local mode every 5s.
HUBITAT_MODE=cloud

# Maker API app ID — the number in the Maker API URL (.../apps/api/19/...).
# Used by both modes.
HUBITAT_APP_ID=19

# --- Local mode (used when HUBITAT_MODE=local) -------------------------------
# Hub LAN address. Give it a DHCP reservation so it doesn't change.
HUBITAT_HOST=http://192.168.1.50
# Access token shown on the Maker API app page (local URLs).
HUBITAT_ACCESS_TOKEN=

# --- Cloud mode (used when HUBITAT_MODE=cloud) -------------------------------
# From the Maker API "Cloud" URLs:
#   https://cloud.hubitat.com/api/<HUBITAT_HUB_ID>/apps/<APP_ID>/devices?access_token=<HUBITAT_CLOUD_TOKEN>
HUBITAT_HUB_ID=
HUBITAT_CLOUD_TOKEN=

# --- App auth ----------------------------------------------------------------
# Dashboard login password. Stored as plaintext here; hashed with bcrypt at startup.
AUTH_PASSWORD=
# Secret used to sign session cookies (min 16 chars). Generate with:
#   openssl rand -hex 32
SESSION_SECRET=

# --- Rule Machine (optional) -------------------------------------------------
# Leave both blank to hide the Rules tab. Rule Machine has its OWN endpoint and
# access token, separate from Maker API. Base URL is up to and including the
# Rule Machine app ID (a pasted "/trigger?access_token=..." suffix is stripped):
#   Local: http://192.168.1.50/apps/api/<rmAppId>
#   Cloud: https://cloud.hubitat.com/api/<hubId>/apps/<rmAppId>
RULE_MACHINE_URL=
RULE_MACHINE_TOKEN=

# --- Automations (optional) --------------------------------------------------
# Timezone for schedules and time conditions (IANA name). Railway servers run
# in UTC, so set this or "11:00 PM" schedules will fire at 11 PM UTC.
TIMEZONE=America/New_York
# Hub location, only needed for "only if it's dark / light" conditions.
LATITUDE=
LONGITUDE=
# Where automations.json is stored. Defaults to <repo>/data (/app/data in Docker).
# DATA_DIR=

# --- Server ------------------------------------------------------------------
# HTTP port. Railway sets PORT automatically (usually 8080); 3001 otherwise.
PORT=3001
