# ── Hubitat mode ──────────────────────────────────────────────────────────────
# "local"  → hub on your LAN (lower latency, default)
# "cloud"  → cloud.hubitat.com (use when deployed remotely, e.g. Railway)
HUBITAT_MODE=local

# ── Local mode (required when HUBITAT_MODE=local) ─────────────────────────────
HUBITAT_HOST=http://192.168.1.x        # Hub LAN IP (no trailing slash)
HUBITAT_APP_ID=123                     # Maker API app ID
HUBITAT_ACCESS_TOKEN=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ── Cloud mode (required when HUBITAT_MODE=cloud) ─────────────────────────────
HUBITAT_CLOUD_TOKEN=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
HUBITAT_HUB_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# HUBITAT_APP_ID is also required in cloud mode (same value as above)

# ── App auth ──────────────────────────────────────────────────────────────────
AUTH_PASSWORD=changeme                 # Dashboard login password (plaintext → bcrypt-hashed at startup)
SESSION_SECRET=replace-with-random-64-char-string

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001                              # Railway overrides this automatically
NODE_ENV=production
